# ============================================
# BASIC CONFIGURATION
# ============================================
NODE_ENV=development
PORT=5000
BACKEND_URL=https://restaruntbot.onrender.com
WEBSITE_URL=https://restarunt-bot.vercel.app
ALLOWED_ORIGINS=https://restarunt-bot.vercel.app

# ============================================
# ADMIN CREDENTIALS
# ============================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# ============================================
# DATABASE (MongoDB Atlas)
# Get from: https://www.mongodb.com/cloud/atlas
# Free tier: 512 MB storage
# ============================================
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/restaurant_bot?retryWrites=true&w=majority

# ============================================
# REDIS (Cache & Queue)
# Cloud: https://redis.com/try-free/ (30 MB free)
# ============================================
REDIS_HOST=redis-xxxxx.xxxxx.ap-south-1-1.ec2.cloud.redislabs.com
REDIS_PORT=18357
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# ============================================
# WHATSAPP BUSINESS API (Meta)
# Get from: https://developers.facebook.com/
# Free tier: 1000 conversations/month
# ============================================
META_PHONE_NUMBER_ID=your_phone_number_id
META_WABA_ID=your_whatsapp_business_account_id
META_ACCESS_TOKEN=your_access_token
META_APP_SECRET=your_app_secret
META_VERIFY_TOKEN=your_custom_verify_token
META_APP_ID=your_meta_app_id
# WHATSAPP_OFFER_TEMPLATE is now auto-managed via offer template system
# Only set this if you want a manual fallback template (not hello_world)
# WHATSAPP_OFFER_TEMPLATE=your_approved_template_name

# ============================================
# PAYMENTS (Razorpay)
# Get from: https://razorpay.com/
# Free tier: Unlimited test transactions
# ============================================
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_CONFIG_ID=config_XXXXXXXXXXXX
MERCHANT_NAME=Your Restaurant Name
MERCHANT_UPI_VPA=9876543210@ybl

# ============================================
# IMAGE STORAGE (Cloudinary)
# Get from: https://cloudinary.com/
# Free tier: 25 GB storage + bandwidth
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# GOOGLE SHEETS API
# Get from: https://console.cloud.google.com/
# Free tier: Unlimited (with rate limits)
# ============================================
GOOGLE_SHEET_ID=your_sheet_id
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your-project","private_key_id":"xxx","private_key":"-----BEGIN PRIVATE KEY-----\nXXX\n-----END PRIVATE KEY-----\n","client_email":"xxx@xxx.iam.gserviceaccount.com","client_id":"xxx","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"xxx"}'

# ============================================
# AI CHATBOT (Groq)
# Get from: https://console.groq.com/
# Free tier: 14,400 requests/day
# ============================================
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ============================================
# EMAIL SERVICE (Brevo)
# Get from: https://www.brevo.com/
# Free tier: 300 emails/day
# ============================================
BREVO_API_KEY=xkeysib-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
BREVO_FROM_EMAIL=your-email@gmail.com
BREVO_FROM_NAME=Your Restaurant Name
REPORT_EMAIL=your-email@gmail.com

# ============================================
# ALERTING (Optional)
# Slack: https://api.slack.com/messaging/webhooks
# ============================================
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
ALERT_EMAIL=your-email@gmail.com

# ============================================
# SECURITY
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================
JWT_SECRET=generate_a_random_secret_key_here

# ============================================
# GOOGLE REVIEW (Optional)
# ============================================
GOOGLE_PLACE_ID=your_google_place_id
GOOGLE_API_KEY=your_google_api_key

# ============================================
# FIREBASE (For Mobile Apps)
# ============================================
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXX\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
DEBUG_MODE=true
LOG_LEVEL=info
ENABLE_CORS=true
ENABLE_COMPRESSION=true
ENABLE_HELMET=true

# ============================================
# PERFORMANCE SETTINGS
# ============================================
CACHE_TTL_MENU=300
CACHE_TTL_ORDERS=60
CACHE_TTL_CUSTOMERS=1800
QUEUE_CONCURRENCY=5
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# ============================================
# NOTIFICATION SETTINGS
# ============================================
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_PUSH_NOTIFICATIONS=true
NOTIFICATION_BATCH_SIZE=10

# ============================================
# BACKUP SETTINGS
# ============================================
ENABLE_AUTO_BACKUP=true
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *

# ============================================
# MONITORING SETTINGS
# ============================================
ENABLE_METRICS=true
METRICS_RETENTION_HOURS=24
HEALTH_CHECK_INTERVAL=30000
